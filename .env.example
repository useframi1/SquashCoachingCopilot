# Application Settings
APP_NAME=SquashCoachingCopilot API
DEBUG=false

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://squash_user:squash_password@localhost:5432/squash_copilot

# Storage Paths
UPLOAD_DIR=backend/storage/uploads
TEMP_DIR=backend/storage/temp

# Video Processing
MAX_VIDEO_SIZE_MB=500
MAX_FPS=30
ENABLE_FPS_CONVERSION=true

# CORS Origins (JSON array format required by Pydantic)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Pipeline Settings
PIPELINE_TIMEOUT_SECONDS=3600
OPENAI_API_KEY=your_openai_api_key